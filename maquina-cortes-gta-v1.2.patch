+      console.error(`Falta "${bin}": ${how}.`);
+      process.exit(1);
+    }
+  }
+
+  const once = args.indexOf('--uma-vez');
+  if (once >= 0) {
+    const f = path.resolve(args[once + 1] || '');
+    if (!fs.existsSync(f)) {
+      console.error('Uso: node vigia-lives.mjs --uma-vez video.mp4 [--sem-postar]');
+      process.exit(1);
+    }
+    const cfg = loadCfg();
+    const dir = path.join(cfg.pasta, 'teste', slug(path.basename(f)));
+    fs.mkdirSync(dir, {recursive: true});
+    const name = 'p0-000' + path.extname(f).toLowerCase();
+    fs.copyFileSync(f, path.join(dir, name));
+    await processBlock({dir, file: name, info: {id: slug(path.basename(f)), canal: 'teste', titulo: path.basename(f)}}, cfg);
+    save();
+    return;
+  }
+
+  log(`Vigia ligado${DRY ? ' (sem postar)' : ''}. Para pausar, crie ${PAUSE}.`);
+  let lastCheck = 0;
+  let wasPaused = false;
+  for (;;) {
+    const cfg = loadCfg(); // relido a cada volta: dá para mudar o automatico.json sem reiniciar
+    if (paused(cfg)) {
+      if (!wasPaused) log('Pausado. Gravações em andamento continuam; nada novo é processado nem postado.');
+      wasPaused = true;
+      await sleep(30e3);
+      continue;
+    }
+    if (wasPaused) log('Voltou a rodar.');
+    wasPaused = false;
+
+    if (Date.now() - lastCheck > cfg.checarACadaSegundos * 1000) {
+      lastCheck = Date.now();
+      for (const url of cfg.canais || []) {
+        const rec = recorders.get(url);
