+    ['yt-dlp', 'instale o yt-dlp'],
+    ['ffmpeg', 'instale o FFmpeg'],
+    ['claude', 'instale o Claude Code'],
+    ...(DRY ? [] : [['postiz', 'npm install -g postiz']]),
