index 0000000..686ead9
--- /dev/null
+++ b/skills/maquina-cortes-gta/template/scripts/postar.mjs
@@ -0,0 +1,86 @@
+#!/usr/bin/env node
+// Posta um corte no YouTube (Shorts), no TikTok e no Instagram (Reels) pelo Postiz (CLI "postiz").
+// As redes e os ajustes ficam em ~/.maquina-cortes-gta/automatico.json ("redes" e "ajustes").
+//
+//   node postar.mjs --conferir                      confere o login e mostra as regras de cada rede configurada
+//   node postar.mjs <video.mp4> "Título" ["descrição"] [--rede youtube] [--quando 2026-11-20T18:00:00Z]
+//                                                   posta agora (+2 min) ou na data dada
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {runBinAsync} from './bin.mjs';
+
+const HOME = path.join(os.homedir(), '.maquina-cortes-gta');
+const postiz = (args) => runBinAsync('postiz', 'postiz', args, {timeoutMs: 15 * 60e3});
+
+export function loadAuto() {
+  try {
+    return JSON.parse(fs.readFileSync(path.join(HOME, 'automatico.json'), 'utf8'));
+  } catch {
+    return {};
+  }
+}
+
+// Ajustes padrão de cada rede. O que o Postiz exigir a mais vai em "ajustes" no automatico.json
+// (veja com --conferir). TikTok: DIRECT_POST publica; "UPLOAD" só deixa na caixa de entrada do app.
+const DEFAULTS = {
+  youtube: (t) => ({title: t.slice(0, 100), type: 'public'}),
+  tiktok: () => ({privacy_level: 'PUBLIC_TO_EVERYONE', duet: false, stitch: false, comment: true, content_posting_method: 'DIRECT_POST'}),
+  instagram: () => ({post_type: 'post'}),
+};
+
+function caption(rede, {titulo, descricao, credito}, cfg) {
+  const tags = (cfg.hashtags ?? ['#gta6', '#gta', '#shorts']).join(' ');
+  const parts = rede === 'youtube' ? [descricao] : [titulo, descricao];
+  if (credito) parts.push(`Créditos: ${credito}`);
+  parts.push(tags);
+  return parts.filter(Boolean).join('\n\n');
+}
+
+// Devolve [{rede, ok, erro?}]
+export async function postClip({video, titulo, descricao = '', credito = '', quando = new Date(Date.now() + 2 * 60e3), redes, cfg = loadAuto(), log = console.log}) {
+  const alvo = Object.entries(cfg.redes || {}).filter(([r, id]) => id && (!redes || redes.includes(r)));
+  if (!alvo.length) return [{rede: '-', ok: false, erro: 'nenhuma rede em "redes" no automatico.json'}];
+  const up = await postiz(['upload', video]);
+  let url;
+  try {
+    url = JSON.parse(up.out).path;
+  } catch {
+    /* sem json */
+  }
+  if (!up.ok || !url) return [{rede: '-', ok: false, erro: `upload falhou: ${up.err || up.out}`.slice(0, 300)}];
+  const out = [];
+  for (const [rede, id] of alvo) {
+    const settings = {...(DEFAULTS[rede]?.(titulo) || {}), ...(cfg.ajustes?.[rede] || {})};
+    const r = await postiz(['posts:create', '-c', caption(rede, {titulo, descricao, credito}, cfg), '-s', quando.toISOString(), '-m', url, '-i', id, '--settings', JSON.stringify(settings)]);
+    out.push({rede, ok: r.ok, erro: r.ok ? undefined : (r.err || r.out).slice(0, 300)});
+    log(`${r.ok ? 'agendado' : 'FALHOU'} ${rede} ${quando.toISOString()} ${titulo}${r.ok ? '' : ' :: ' + (r.err || r.out).slice(0, 200)}`);
+  }
+  return out;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const args = process.argv.slice(2);
+  const cfg = loadAuto();
+  if (args[0] === '--conferir') {
+    const a = await postiz(['auth:status']);
+    console.log(a.ok ? 'Postiz: logado.' : `Postiz: NÃO logado (${a.err || a.out}). Rode: postiz auth:login`);
+    if (!a.ok) process.exit(1);
+    console.log('\nContas conectadas no Postiz:\n' + (await postiz(['integrations:list'])).out);
+    for (const [rede, id] of Object.entries(cfg.redes || {})) {
+      if (!id) continue;
+      const s = await postiz(['integrations:settings', id]);
+      console.log(`\n=== ${rede} (${id}) ===\n${s.ok ? s.out : 'erro: ' + s.err}`);
+    }
+    process.exit(0);
+  }
+  const [video, titulo, descricao] = args.filter((x, i) => !x.startsWith('--') && !args[i - 1]?.startsWith('--'));
+  if (!video || !titulo || !fs.existsSync(video)) {
+    console.error('Uso: node postar.mjs <video.mp4> "Título" ["descrição"] [--rede youtube] [--quando ISO]  |  node postar.mjs --conferir');
+    process.exit(1);
+  }
+  const opt = (n) => (args.includes(n) ? args[args.indexOf(n) + 1] : undefined);
+  const res = await postClip({video, titulo, descricao, redes: opt('--rede')?.split(','), quando: opt('--quando') ? new Date(opt('--quando')) : undefined, cfg});
+  process.exit(res.every((r) => r.ok) ? 0 : 1);
+}
diff --git a/skills/maquina-cortes-gta/template/scripts/vigia-lives.mjs b/skills/maquina-cortes-gta/template/scripts/vigia-lives.mjs
new file mode 100644
index 0000000..ad80482
--- /dev/null
+++ b/skills/maquina-cortes-gta/template/scripts/vigia-lives.mjs
@@ -0,0 +1,329 @@
+#!/usr/bin/env node
+// MODO AUTOMÁTICO: vigia canais, grava as lives em blocos, escolhe os cortes com o Claude Code, renderiza e posta
+// no YouTube, TikTok e Instagram pelo Postiz. Roda no seu computador enquanto estiver aberto.
+//
+//   node vigia-lives.mjs                       vigia os canais do automatico.json (deixe rodando)
+//   node vigia-lives.mjs --exemplo             cria ~/.maquina-cortes-gta/automatico.json de exemplo
+//   node vigia-lives.mjs --uma-vez video.mp4   processa um arquivo como se fosse um bloco de live (teste)
+//   ... --sem-postar                           faz tudo, menos postar (teste)
+//
+// Pausar: crie o arquivo ~/.maquina-cortes-gta/PAUSAR (ou "pausado": true no automatico.json). Apague para voltar.
+// Registro de tudo que acontece: ~/.maquina-cortes-gta/automatico.log
+import {spawn} from 'node:child_process';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {resolveBin, runAsync, runBinAsync} from './bin.mjs';
+import {postClip} from './postar.mjs';
+
+const HOME = path.join(os.homedir(), '.maquina-cortes-gta');
+const ENGINE = path.join(HOME, 'engine');
+const S = path.dirname(fileURLToPath(import.meta.url));
+const CFG = path.join(HOME, 'automatico.json');
+const STATE = path.join(HOME, 'automatico-estado.json');
+const LOG = path.join(HOME, 'automatico.log');
+const PAUSE = path.join(HOME, 'PAUSAR');
+const args = process.argv.slice(2);
+const DRY = args.includes('--sem-postar');
+
+const EXEMPLO = {
+  canais: ['https://www.youtube.com/@CANAL_DO_STREAMER', 'https://www.twitch.tv/CANAL_DO_STREAMER'],
+  redes: {youtube: 'ID_DO_POSTIZ', tiktok: 'ID_DO_POSTIZ', instagram: 'ID_DO_POSTIZ'},
+  ajustes: {youtube: {}, tiktok: {}, instagram: {}},
+  hashtags: ['#gta6', '#gta', '#shorts'],
+  creditar: true,
+  idioma: 'pt',
+  bottom: 'https://www.youtube.com/watch?v=rz1B4B2yBZY',
+  pasta: path.join(HOME, 'auto'),
+  blocoSegundos: 900,
+  checarACadaSegundos: 120,
+  notaMinima: 7,
+  maxCortesPorBloco: 2,
+  maxPostsPorDia: 6,
+  minutosEntrePosts: 45,
+  apagarBrutos: true,
+  claudeArgs: ['--allowedTools', 'Read,Write,Edit,Bash(node:*)'],
+  pausado: false,
+};
+
+const log = (...m) => {
+  const line = `[${new Date().toLocaleString('pt-BR')}] ${m.join(' ')}`;
+  console.log(line);
+  try {
+    fs.appendFileSync(LOG, line + '\n');
+  } catch {
+    /* sem log em disco */
+  }
+};
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const readJson = (f, fb) => {
+  try {
+    return JSON.parse(fs.readFileSync(f, 'utf8'));
+  } catch {
+    return fb;
+  }
+};
+const loadCfg = () => ({...EXEMPLO, ...readJson(CFG, {})});
+const state = readJson(STATE, {gravacoes: {}, postados: [], agenda: [], recentes: []});
+const save = () => fs.writeFileSync(STATE, JSON.stringify(state, null, 2));
+const slug = (s) =>
+  String(s || 'canal')
+    .toLowerCase()
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '')
+    .slice(0, 40) || 'canal';
+const paused = (cfg) => cfg.pausado || fs.existsSync(PAUSE);
+
+// ---------- config de exemplo ----------
+if (args.includes('--exemplo')) {
+  fs.mkdirSync(HOME, {recursive: true});
+  if (fs.existsSync(CFG)) console.log(`Já existe: ${CFG} (não mexi).`);
+  else {
+    fs.writeFileSync(CFG, JSON.stringify(EXEMPLO, null, 2));
+    console.log(`Criado: ${CFG}. Preencha "canais" e "redes".`);
+  }
+  process.exit(0);
+}
+
+// ---------- live? ----------
+const liveUrl = (u) => (/youtube\.com\/(@|channel\/|c\/)/.test(u) && !/\/live\/?$/.test(u) ? u.replace(/\/$/, '') + '/live' : u);
+async function liveInfo(url) {
+  const r = await runAsync(resolveBin('yt-dlp')?.cmd || 'yt-dlp', ['--no-warnings', '--skip-download', '--playlist-items', '1', '--print', '%(live_status)s\t%(id)s\t%(channel,uploader)s\t%(title)s', liveUrl(url)], {timeoutMs: 90e3});
+  if (!r.ok) return null;
+  const [status, id, canal, titulo] = r.out.trim().split('\n').pop().split('\t');
+  return status === 'is_live' ? {id, canal, titulo, url: liveUrl(url)} : null;
+}
+
+// ---------- gravação em blocos ----------
+const recorders = new Map(); // url -> {dir, info, done}
+function startRecording(url, info, cfg) {
+  const dir = path.join(cfg.pasta, slug(info.canal), `${new Date().toISOString().slice(0, 10)}-${slug(info.id)}`);
+  fs.mkdirSync(dir, {recursive: true});
+  const part = `p${Date.now()}`;
+  const rec = {dir, info, done: false, part};
+  state.gravacoes[dir] ??= {processados: [], info, inicio: Date.now()};
+  save();
+  const yt = spawn(resolveBin('yt-dlp')?.cmd || 'yt-dlp', ['--no-warnings', '--no-part', '-f', 'best[height<=1080]/best', '-o', '-', info.url], {stdio: ['ignore', 'pipe', 'ignore']});
+  const ff = spawn('ffmpeg', ['-hide_banner', '-loglevel', 'error', '-i', 'pipe:0', '-map', '0:v:0?', '-map', '0:a:0?', '-c', 'copy', '-f', 'segment', '-segment_time', String(cfg.blocoSegundos), '-reset_timestamps', '1', path.join(dir, `${part}-%03d.ts`)], {stdio: ['pipe', 'ignore', 'ignore']});
+  yt.stdout.pipe(ff.stdin);
+  yt.stdout.on('error', () => {});
+  ff.stdin.on('error', () => {});
+  yt.on('close', () => ff.stdin.end());
+  yt.on('error', (e) => log(`yt-dlp falhou: ${e.message}`));
+  ff.on('close', () => {
+    rec.done = true;
+    log(`Gravação parou: ${info.canal} (a live acabou ou caiu; se ainda estiver no ar, volto a gravar na próxima checagem).`);
+  });
+  recorders.set(url, rec);
+  log(`AO VIVO: ${info.canal} — "${info.titulo}". Gravando em blocos de ${cfg.blocoSegundos >= 60 ? Math.round(cfg.blocoSegundos / 60) + " min" : cfg.blocoSegundos + " s"}.`);
+}
+
+// blocos prontos = todos menos o último de cada parte (que ainda está sendo gravado), a não ser que a gravação acabou
+function readyBlocks() {
+  const out = [];
+  for (const [dir, g] of Object.entries(state.gravacoes)) {
+    if (!fs.existsSync(dir)) continue;
+    const live = [...recorders.values()].find((r) => r.dir === dir && !r.done);
+    const files = fs.readdirSync(dir).filter((f) => /^p\d+-\d{3}\.ts$/.test(f)).sort();
+    for (const f of files) {
+      if (g.processados.includes(f)) continue;
+      const growing = live && f.startsWith(live.part) && f === files.filter((x) => x.startsWith(live.part)).pop();
+      if (!growing) out.push({dir, file: f, info: g.info});
+    }
+  }
+  return out;
+}
+
+// ---------- agenda de posts ----------
+function nextSlot(cfg) {
+  const now = Date.now();
+  state.agenda = state.agenda.filter((t) => t > now - 26 * 3600e3);
+  const last = state.agenda.length ? Math.max(...state.agenda) : 0;
+  const t = Math.max(now + 2 * 60e3, last + cfg.minutosEntrePosts * 60e3);
+  const inDay = state.agenda.filter((x) => x > t - 24 * 3600e3).length;
+  if (inDay >= cfg.maxPostsPorDia || t > now + 24 * 3600e3) return null;
+  return t;
+}
+
+// ---------- vídeo de baixo (baixado uma vez) ----------
+async function bottomFile(cfg) {
+  if (cfg.bottom && fs.existsSync(cfg.bottom)) return cfg.bottom;
+  const cached = path.join(HOME, 'cache', 'bottom.mp4');
+  if (fs.existsSync(cached)) return cached;
+  fs.mkdirSync(path.dirname(cached), {recursive: true});
+  log('Baixando o vídeo da metade de baixo (uma vez só)…');
+  const r = await runAsync(resolveBin('yt-dlp')?.cmd || 'yt-dlp', ['-S', 'res:720', '-f', 'bv*+ba/b', '--merge-output-format', 'mp4', '--no-playlist', '-o', cached, cfg.bottom]);
+  return r.ok && fs.existsSync(cached) ? cached : null;
+}
+
+// ---------- um bloco: transcrever → Claude escolhe → conferir → render → postar ----------
+async function processBlock({dir, file, info}, cfg) {
+  const src = path.join(dir, file);
+  const base = path.join(dir, file.replace(/\.ts$|\.mp4$/i, ''));
+  const work = path.join(base, 'work');
+  fs.mkdirSync(work, {recursive: true});
+  const tag = `${info.canal} ${file}`;
+
+  let r = await runAsync('ffmpeg', ['-y', '-v', 'error', '-i', src, '-c', 'copy', '-movflags', '+faststart', path.join(work, 'source.mp4')]);
+  if (!r.ok) r = await runAsync('ffmpeg', ['-y', '-v', 'error', '-i', src, '-c:v', 'libx264', '-preset', 'veryfast', '-c:a', 'aac', path.join(work, 'source.mp4')]);
+  if (!r.ok) return log(`${tag}: não consegui preparar o vídeo (${r.err.slice(0, 150)}).`);
+  const bottom = await bottomFile(cfg);
