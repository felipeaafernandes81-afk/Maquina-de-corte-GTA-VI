+// Lógica da linha do tempo dos cortes, sem efeitos colaterais (dá para testar e reaproveitar).
+// Usada pelo build.mjs (render) e pelo conferir-cortes.mjs (conferência antes do render).
+// Tempos em segundos, a não ser onde o nome diz Ms.
+
+const END_OF_PHRASE = /[.!?…]["”')\]]*$/;
+export const sec = (ms) => ms / 1000;
+
+// Última palavra que começa antes de `t`.
+function wordBefore(words, t) {
+  let found = null;
+  for (const w of words) {
+    if (sec(w.startMs) < t) found = w;
+    else break;
+  }
+  return found;
+}
+
+// Encaixa o início e o fim do corte nas palavras: começa ~0,15 s antes da 1ª palavra do gancho (sem pegar o fim
+// da palavra anterior) e termina ~0,25 s depois da última palavra (sem pegar o começo da seguinte).
+export function snapClip(words, start, end) {
+  const i = words.findIndex((w) => sec(w.startMs) >= start - 0.25);
+  if (i < 0) return {start, end, first: -1, last: -1};
+  let j = -1;
+  for (let k = i; k < words.length && sec(words[k].startMs) < end; k++) j = k;
+  if (j < i) return {start, end, first: -1, last: -1};
+  const firstStart = sec(words[i].startMs);
+  const prevEnd = i > 0 ? sec(words[i - 1].endMs) : 0;
+  const s = Math.max(0, firstStart - 0.15, Math.min(prevEnd + 0.02, firstStart - 0.02));
+  const lastEnd = sec(words[j].endMs);
+  const nextStart = j + 1 < words.length ? sec(words[j + 1].startMs) : Infinity;
+  const e = Math.max(lastEnd, Math.min(lastEnd + 0.25, nextStart - 0.02));
